@page
@model VolchukRazorGames.Pages.GamePages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Game</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Game.Title" class="control-label"></label>
                <input asp-for="Game.Title" class="form-control" />
                <span asp-validation-for="Game.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Game.HourCount" class="control-label"></label>
                <input asp-for="Game.HourCount" class="form-control" />
                <span asp-validation-for="Game.HourCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Game.LastPlayed" class="control-label"></label>
                <input asp-for="Game.LastPlayed" class="form-control" />
                <span asp-validation-for="Game.LastPlayed" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Game.AchievementsEarned" class="control-label"></label>
                <input asp-for="Game.AchievementsEarned" class="form-control" />
                <span asp-validation-for="Game.AchievementsEarned" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Game.AchievementsTotal" class="control-label"></label>
                <input asp-for="Game.AchievementsTotal" class="form-control" />
                <span asp-validation-for="Game.AchievementsTotal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
