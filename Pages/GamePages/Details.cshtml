        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Game.LastPlayed)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Game.LastPlayed)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Game.AchievementsEarned)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Game.AchievementsEarned)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Game.AchievementsTotal)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Game.AchievementsTotal)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Game.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Game.Price)
        </dd>
